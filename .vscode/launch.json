    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Current",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Track video",
            "type": "debugpy",
            "request": "launch",
            "program": "boxmot/engine/cli.py",
            "console": "integratedTerminal",
            "args": [
                "track",
                "--yolo-model",
                "yolov8x.pt",
                "--tracking-method",
                "bytetrack",
                "--source",
                "/mnt/dknas/MEVA/videos/2018-03-07/09/2018-03-07.09-11-05.09-15-05.school.G424.r13.avi",
                "--name",
                "track/VIRAT_S_000200_05_001525_001575",
                "--show"                
            ],
            "justMyCode": false
        },
        {
            "name": "Track videos",
            "type": "debugpy",
            "request": "launch",
            "program": "custom/track_videos.py",
            "console": "integratedTerminal",
            "args": [
                "--video-dir",
                "/mnt/dknas/MEVA/videos/2018-03-07",
                "--yolo-model",
                "yolov8x.pt",
                "--tracking-method",
                "bytetrack",
                "--save-txt"
            ]
        },
        {
            "name": "Vis tracking",
            "type": "debugpy",
            "request": "launch",
            "program": "custom/vis_tracking.py",
            "console": "integratedTerminal",
            "args": [
                "--video-filepath",
                "/mnt/dknas/MEVA/videos/2018-03-07/09/2018-03-07.09-11-05.09-15-05.school.G336.r13.avi",
                "--ann-dir",
                "data/Milestone_MEVA/track"
            ]
        },
    ]
}
